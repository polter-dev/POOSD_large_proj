{
  "info": {
    "name": "Menu Macro Fitter API",
    "description": "Every endpoint in docs/api-contract.md. Run it against a local API loaded with db/seed.js (the default baseUrl, http://localhost:5050/api). Auth > Login saves the JWT to the token variable and every request after it sends it as a Bearer token. Seed accounts all use the password Password123! (backend/db/README.md).\n\nSafe to run repeatedly: it registers a new user each run, uses made-up verify/reset tokens, and puts back what it changes on janedoe. Don't point baseUrl at production (https://cop4331ruth.lol/api): Register, Resend and Forgot send real emails there and every run adds a user.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5050/api"
    },
    {
      "key": "email",
      "value": "jane.doe@example.com"
    },
    {
      "key": "password",
      "value": "Password123!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "newUser",
      "value": ""
    },
    {
      "key": "placeId",
      "value": ""
    },
    {
      "key": "favoriteId",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "submissionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"db connected\", () => pm.expect(pm.response.json().db).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates an unverified account. Locally the verify link is printed in the server console; on the server it is emailed (SendGrid).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Demo\",\n  \"lastName\": \"User\",\n  \"username\": \"{{newUser}}\",\n  \"email\": \"{{newUser}}@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"newUser\", \"demo\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (email taken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
