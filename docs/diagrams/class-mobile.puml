@startuml class-mobile
' Menu Macro Fitter -- class diagram of the Flutter Android app (issue #38)
' Traced from mobile/lib. Screens show the fields passed to them and their key state;
' widgets that only draw (AppCard, Pill, MacroBar, ErrorBanner...) are left out.
' M6 adds the Saved and Tracker tabs, meal plans, photo logging and community submissions (#118-#120).

!theme plain

skinparam defaultFontName Verdana
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ClassBackgroundColor White
skinparam ClassBorderColor #333333
skinparam ArrowColor #444444
skinparam PackageBorderColor #4A6FA5
skinparam PackageFontColor #4A6FA5
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #C9A227
skinparam nodesep 40
skinparam ranksep 60
hide empty members

title Menu Macro Fitter -- Mobile App Classes (Flutter)

package "App" {
  class MenuMacroFitterApp <<StatelessWidget>> {
    + api : Api
    + location : LocationSource
    + photos : PhotoSource
    + build() : MaterialApp
  }
  class ApiScope <<InheritedWidget>> {
    + api : Api
    + location : LocationSource
    + photos : PhotoSource
    + {static} of(context) : Api
    + {static} locationOf(context) : LocationSource
    + {static} photosOf(context) : PhotoSource
  }
  note right of ApiScope
    Every screen reaches the Api, the LocationSource
    and the PhotoSource through ApiScope, so tests swap
    in a fake server, location and camera.
  end note
}

package "Screens" {
  class LoginScreen {
    + info : String?
    - error : String?
    - notVerified : bool
    - submit()
    - resend()
  }
  class SignUpScreen {
    - submit()
  }
  class ForgotPasswordScreen {
    - submit()
  }
  class CheckEmailScreen {
    + email : String
    + forReset : bool
    - resend()
  }
  class ProfileScreen {
    + user : User
    + setup : bool
    - units : Units
    - switchUnits(Units)
    - submit()
  }
  class AppShell {
    + user : User
    + initialTab : AppTab
    - tab : AppTab
  }
  class TargetsScreen {
    + user : User
    - cal : Calories?
    - load()
    - edit()
  }
  class NearbyScreen {
    + user : User
    + active : bool
    - radius : int
    - here : LatLng?
    - restaurants : List<NearbyRestaurant>?
    - fits : Map<String, int>?
    - saved : Map<String, String>
    - load()
    - setRadius(int)
    - toggleSaved(NearbyRestaurant)
  }
  class PicksScreen {
    + user : User
    + chainId : String?
    + restaurantName : String?
    - mode : RecommendationMode
    - load()
  }
  class SearchScreen {
    - items : List<MenuItem>
    - total : int
    - search(more)
  }
  class FavoritesScreen {
    + active : bool
    - favorites : List<Favorite>?
    - load()
    - remove(Favorite)
  }
  class TrackerScreen {
    + user : User
    + onUser : ValueChanged<User>
    - day : DateTime
    - cal : Calories?
    - logs : MealLogsResponse?
    - load()
    - toggle(Nutrient)
    - add()
  }
  class PlanScreen {
    + user : User
    + start : DateTime
    - days : int
    - nearbyOnly : bool
    - plan : MealPlanResponse?
    - load()
    - add(date, items)
  }
  class PhotoLogScreen {
    + date : DateTime
    - photo : MealPhoto?
    - pick(PhotoFrom)
    - analyze()
    - log()
  }
  class MySubmissionsScreen {
    - list : List<Submission>?
    - total : int
    - load()
    - more()
  }
  class ItemFormScreen {
    + item : MenuItem?
    + chainId : String?
    + chainName : String?
    - submit()
  }
  class ChainFormScreen {
    + initialName : String
    - submit()
  }
  enum AppTab {
    nearby
    picks
    search
    saved
    tracker
    profile
  }
}

package "Services" {
  class Api {
    + register(...) : Future<String>
    + hasToken() : Future<bool>
    + login(login, password) : Future<LoginResponse>
    + logout() : Future<void>
    + resendVerification(login) : Future<String>
    + forgotPassword(email) : Future<String>
    + getMe() : Future<User>
    + updateProfile(Profile) : Future<User>
    + updatePreferences(...) : Future<User>
    + getCalories() : Future<Calories>
    + searchMenuItems(q, limit, skip) : Future<SearchMenuItemsResponse>
    + recommendations(mode, chainIds, limit) : Future<RecommendationsResponse>
    + nearby(lat, lng, radiusMiles) : Future<List<NearbyRestaurant>>
    + getFavorites() : Future<List<Favorite>>
    + addFavorite(placeId, label) : Future<Favorite>
    + removeFavorite(id) : Future<void>
    + getMealLogs(from, to) : Future<MealLogsResponse>
    + addMealLogs(entries) : Future<List<MealLog>>
    + updateMealLog(id, status, servings) : Future<MealLog>
    + deleteMealLog(id) : Future<void>
    + getMealPlan(start, days, chainIds, mode) : Future<MealPlanResponse>
    + analyzePhoto(imageBase64, mediaType) : Future<List<PhotoItem>>
    + createSubmission(kind, targetId, payload) : Future<Submission>
    + getMySubmissions(limit, skip) : Future<MySubmissionsResponse>
  }
  class ApiClient {
    + baseUrl : String
    + tokens : TokenStore
    + request(method, path, body, timeout) : Future<dynamic>
  }
  class ApiError <<Exception>> {
    + message : String
    + status : int
    + fromApi : bool
  }
  interface TokenStore {
    + read() : Future<String?>
    + write(token)
    + clear()
  }
  class PrefsTokenStore
  class MemoryTokenStore
  interface LocationSource {
    + current() : Future<LatLng>
    + openSettings(LocationProblem)
  }
  class DeviceLocation
  class LocationException <<Exception>> {
    + problem : LocationProblem
  }
  enum LocationProblem {
    serviceOff
    denied
    blocked
    unavailable
  }
  class LatLng {
    + lat : double
    + lng : double
  }
  interface PhotoSource {
    + pick(PhotoFrom) : Future<List<int>?>
  }
  class DevicePhotos
  class MealPhoto {
    + base64 : String
    + mediaType : String
    + {static} fromBytes(bytes) : MealPhoto?
  }
  enum PhotoFrom {
    camera
    gallery
  }
}

package "Models (API JSON)" {
  class User {
    + id : String
    + firstName : String
    + lastName : String
    + username : String
    + email : String
    + isVerified : bool
    + role : UserRole
  }
  class Profile {
    + heightIn : double
    + weightLb : double
    + birthDate : String
    + sex : Sex
    + activityLevel : ActivityLevel
    + goal : Goal
  }
  class Preferences {
    + units : Units
    + searchRadius : int
    + recommendationMode : RecommendationMode
    + mealCalorieLimit : double?
    + trackedNutrients : List<Nutrient>
  }
  class Calories {
    + age : int
    + maintenance : int
    + target : int
    + perMeal : int
  }
  class MacroTargets {
    + proteinG : int
    + carbsG : int
    + fatG : int
  }
  class MenuItem {
    + id : String
    + chainId : String
    + chainName : String
    + name : String
    + category : Category
    + calories : double
    + proteinG : double?
    + carbsG : double?
    + fatG : double?
    + isEstimate : bool
  }
  class RecommendedItem {
    + score : double
  }
  class RecommendationsResponse {
    + mode : RecommendationMode
    + mealCalorieLimit : double
  }
  class SearchMenuItemsResponse {
    + total : int
    + limit : int
    + skip : int
  }
  class NearbyRestaurant {
    + placeId : String
    + name : String
    + address : String?
    + distanceMiles : double
    + chainId : String?
  }
  class LoginResponse {
    + token : String
  }
  class Favorite {
    + id : String
    + placeId : String
    + label : String?
  }
  class Totals {
    + calories : int
    + proteinG : double
    + carbsG : double
    + fatG : double
    + incomplete : bool
  }
  class MealLog {
    + id : String
    + date : String
    + menuItemId : String?
    + name : String
    + servings : double
    + calories : double
  }
  class MealLogEntry {
    + date : String
    + menuItemId : String?
    + servings : double?
    + name : String?
    + calories : double?
  }
  class MealLogDay {
    + date : String
  }
  class MealLogsResponse
  class MealPlanDay {
    + date : String
    + remainingCalories : int
    + mealCalorieLimit : int
  }
  class MealPlanResponse {
    + mode : RecommendationMode
  }
  class PhotoItem {
    + menuItemId : String?
    + name : String
    + servings : double
    + calories : double
  }
  class Submission {
    + id : String
    + targetId : String?
    + payload : Map<String, dynamic>
    + reviewNote : String?
  }
  class MySubmissionsResponse {
    + total : int
  }
  enum Sex {
    male
    female
  }
  enum ActivityLevel {
    sedentary
    light
    moderate
    active
    veryActive
  }
  enum Goal {
    lose
    maintain
    gain
  }
  enum Units {
    imperial
    metric
  }
  enum RecommendationMode {
    protein
    carb
  }
  enum Category {
    entree
    side
    breakfast
    salad
    drink
    dessert
  }
  enum UserRole {
    user
    admin
  }
  enum Nutrient {
    calories
    protein
    carbs
    fat
  }
  enum MealLogStatus {
    planned
    eaten
  }
  enum MealLogSource {
    search
    plan
    photo
    custom
  }
  enum PhotoConfidence {
    high
    medium
    low
  }
  enum SubmissionKind {
    editItem
    newItem
    newChain
  }
  enum SubmissionStatus {
    autoApplied
    pending
    approved
    rejected
    reverted
  }
}

' --- app wiring
MenuMacroFitterApp *-- ApiScope : provides
ApiScope o-- Api
ApiScope o-- LocationSource
ApiScope o-- PhotoSource

' --- navigation (who opens whom)
MenuMacroFitterApp ..> LoginScreen : no saved session
MenuMacroFitterApp ..> AppShell : saved session
LoginScreen ..> SignUpScreen : opens
LoginScreen ..> ForgotPasswordScreen : opens
SignUpScreen ..> CheckEmailScreen : registered
ForgotPasswordScreen ..> CheckEmailScreen : link sent
LoginScreen ..> ProfileScreen : no profile yet
LoginScreen ..> AppShell : logged in
ProfileScreen ..> AppShell : saved (setup)
AppShell *-- "1" TargetsScreen : Profile tab
AppShell *-- "1" NearbyScreen : Nearby tab
AppShell *-- "1" PicksScreen : Picks tab
AppShell *-- "1" SearchScreen : Search tab
AppShell *-- "1" FavoritesScreen : Saved tab
AppShell *-- "1" TrackerScreen : Tracker tab
AppShell --> AppTab
TargetsScreen ..> ProfileScreen : Edit
NearbyScreen ..> PicksScreen : tap a restaurant
TrackerScreen ..> PlanScreen : Plan meals
TrackerScreen ..> PhotoLogScreen : Log a photo
TargetsScreen ..> MySubmissionsScreen : My submissions
MySubmissionsScreen ..> ChainFormScreen : Add a restaurant
NearbyScreen ..> ChainFormScreen : Add this restaurant
NearbyScreen ..> ItemFormScreen : Add a missing item
PicksScreen ..> ItemFormScreen : Add item,\nSuggest a correction
SearchScreen ..> ItemFormScreen : Suggest a correction
ItemFormScreen ..> MySubmissionsScreen : sent
ChainFormScreen ..> MySubmissionsScreen : sent

' --- screens use services through ApiScope
LoginScreen ..> Api : via ApiScope\n(every screen)
NearbyScreen ..> LocationSource : current()
PhotoLogScreen ..> PhotoSource : pick()

' --- services
Api *-- ApiClient
ApiClient o-- TokenStore
ApiClient ..> ApiError : throws
TokenStore <|.. PrefsTokenStore
TokenStore <|.. MemoryTokenStore : tests
LocationSource <|.. DeviceLocation
DeviceLocation ..> LocationException : throws
LocationException --> LocationProblem
LocationSource ..> LatLng
PhotoSource <|.. DevicePhotos
PhotoSource ..> PhotoFrom
PhotoLogScreen ..> MealPhoto : fromBytes()
PhotoSource -[hidden]- MealPhoto
Api ..> User : returns

' --- models
User *-- "0..1" Profile : null until set up
User *-- "1" Preferences
User --> UserRole
Calories *-- "1" MacroTargets
LoginResponse *-- "1" User
RecommendationsResponse *-- "*" RecommendedItem
RecommendedItem *-- MenuItem
SearchMenuItemsResponse *-- "*" MenuItem
Profile --> Sex
Profile --> ActivityLevel
Profile --> Goal
Preferences --> Units
Preferences --> RecommendationMode
Preferences --> "1..4" Nutrient : tracked
MenuItem --> Category
NearbyRestaurant ..> MenuItem : chainId links to\nthe chain's items
Favorite ..> NearbyRestaurant : placeId
MealLogsResponse *-- "*" MealLog
MealLogsResponse *-- "*" MealLogDay
MealLogDay *-- "2" Totals : eaten, planned
MealLog --> MealLogStatus
MealLog --> MealLogSource
MealLogEntry --> MealLogSource
MealPlanResponse *-- "*" MealPlanDay
MealPlanDay *-- "*" RecommendedItem
MealPlanDay *-- "1" Totals
PhotoItem --> PhotoConfidence
PhotoItem ..> MealLogEntry : confirmed as
MySubmissionsResponse *-- "*" Submission
Submission --> SubmissionKind
Submission --> SubmissionStatus

@enduml
