# Port the API listens on
PORT=5050
# MongoDB connection string (database name MenuMacroFitter is set in src/config/db.js)
MONGODB_URI=mongodb://localhost:27017
# Web client origin, used to build links in verification and reset emails
CLIENT_URL=http://localhost:5173
# Overpass (OpenStreetMap) endpoint for nearby search; no key needed. Optional, defaults to the public server
OVERPASS_URL=https://overpass-api.de/api/interpreter
# SendGrid API key with Mail Send permission; leave empty locally to log email links instead of sending
SENDGRID_API_KEY=
# Sender address; must be a Single Sender verified in SendGrid
EMAIL_FROM=
